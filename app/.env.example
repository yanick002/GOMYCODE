# Copier ce fichier en .env (local) ou saisir ces variables sur Render.
# Ne jamais commiter le .env.

# --- Supabase : Project Settings > API ---------------------------------
SUPABASE_URL=
# Cle "publishable" (sb_publishable_...) ou ancienne cle "anon". Publique par
# conception : c'est la Row Level Security qui protege les donnees.
SUPABASE_PUBLISHABLE_KEY=

# --- Modele : tout fournisseur compatible OpenAI ------------------------
# Changer de modele = changer ces trois lignes. Le modele doit savoir
# appeler des outils (function calling). Exemples :
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Together    LLM_BASE_URL=https://api.together.xyz/v1
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1   (LLM_API_KEY vide)
# Le nom exact du modele se trouve dans la liste du fournisseur.
# LLM_MODEL accepte plusieurs modeles separes par des virgules : les suivants
# servent de secours si le premier est sature ou hors quota (offres gratuites).
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#               LLM_MODEL=gemini-3.8-flash,gemini-3.6-flash
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Donnees de marche ---------------------------------------------------
MCP_URL=https://gomycode-1.onrender.com/mcp
