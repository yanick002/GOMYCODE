# Copier ce fichier en .env (local) ou saisir ces variables sur Render.
# Ne jamais commiter le .env.

# --- Supabase : Project Settings > API ---------------------------------
SUPABASE_URL=
# Cle "publishable" (sb_publishable_...) ou ancienne cle "anon". Publique par
# conception : c'est la Row Level Security qui protege les donnees.
SUPABASE_PUBLISHABLE_KEY=

# --- Modeles --------------------------------------------------------------
# Les modeles proposes dans le menu sont declares dans modeles.json (URL du
# fournisseur, nom de la variable de cle, logo). Ici, seulement les cles :
# un fournisseur sans cle n'apparait pas dans le menu.
MODELSCOPE_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# --- Donnees de marche ---------------------------------------------------
MCP_URL=https://gomycode-1.onrender.com/mcp
